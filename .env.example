# Server-only variables for Vercel Functions and local Vite API middleware.
# Use the Supabase project URL and server-side service_role key.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
ADMIN_USERNAME=
ADMIN_PASSWORD=
# Generate at least 32 random bytes for signing admin sessions.
SESSION_SECRET=

# Optional browser client. This public publishable key is not a server secret.
# It does not grant access to tables without an explicit Supabase RLS policy.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

